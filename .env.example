# Exemplo de ambiente do shapeai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/shapeai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

SHAPEAI_ADMIN_KEY=
SHAPEAI_CAKTO_SEGREDO=
SHAPEAI_DEMO_SENHA=
SHAPEAI_LLM_KEY=
SHAPEAI_SEGREDO_SESSAO=
SHAPEAI_SMTP_FROM=
SHAPEAI_VISAO_KEY=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
